#include <windows.h>
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenHelloMiddle Project"
            VALUE "FileDescription", "Secure File Erasure Tool"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "randfill"
            VALUE "LegalCopyright", "Copyright (C) 2026 OpenHelloMiddle"
            VALUE "OriginalFilename", "randfill.exe"
            VALUE "ProductName", "RandFill"
            VALUE "ProductVersion", "0.1.0.0"
            VALUE "Comments", "Overwrite files with cryptographically secure random data"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409
    END
END
