#include <windows.h>
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1
 PRODUCTVERSION 1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "OpenHelloMiddle Project"
            VALUE "FileDescription", "Secure File Erasure Tool - Overwrites files with random data"
            VALUE "FileVersion", "1"
            VALUE "InternalName", "randfill"
            VALUE "LegalCopyright", "Copyright (C) 2025 OpenHelloMiddle"
            VALUE "OriginalFilename", "randfill.exe"
            VALUE "ProductName", "RandFill"
            VALUE "ProductVersion", "1"
            VALUE "Comments", "Securely overwrites files with cryptographically strong random bytes"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 0x4b0
    END
END
